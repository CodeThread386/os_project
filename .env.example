# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# One or more Groq API keys, comma-separated. Keys from different Groq
# organisations add capacity; AgentLayer detects which keys share a quota.
GROQ_API_KEYS=gsk_your_key_here

# Optional settings (defaults shown)
# AGENTLAYER_MODEL=openai/gpt-oss-120b
# AGENTLAYER_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# AGENTLAYER_POLICY=phase4-full
# AGENTLAYER_WORKSPACE=~/agentlayer-workspace
# AGENTLAYER_LOCAL_FALLBACK=1
# AGENTLAYER_REASONING_EFFORT=low
# OLLAMA_HOST=localhost:11434
# AGENTLAYER_OLLAMA_MODEL=qwen2.5:7b-instruct
